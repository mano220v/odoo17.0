<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="module_category_converter" model="ir.module.category">
    <field name="name">Document Converter</field>
    <field name="sequence">36</field>
  </record>
  <record id="group_converter_user" model="res.groups">
    <field name="name">User</field>
    <field name="category_id" ref="module_category_converter"/>
  </record>
  <record id="group_converter_manager" model="res.groups">
    <field name="name">Manager</field>
    <field name="category_id" ref="module_category_converter"/>
    <field name="implied_ids" eval="[(4,ref('group_converter_user'))]"/>
  </record>
  <record id="base.group_user" model="res.groups">
    <field name="implied_ids" eval="[(4,ref('ow_document_converter_pro.group_converter_user'))]"/>
  </record>
  <record id="rule_conversion_own" model="ir.rule">
    <field name="name">Users see own conversions</field>
    <field name="model_id" ref="model_ow_document_conversion"/>
    <field name="domain_force">[('user_id','=',user.id)]</field>
    <field name="groups" eval="[(4,ref('group_converter_user'))]"/>
  </record>
  <record id="rule_conversion_manager" model="ir.rule">
    <field name="name">Managers see all conversions</field>
    <field name="model_id" ref="model_ow_document_conversion"/>
    <field name="domain_force">[(1,'=',1)]</field>
    <field name="groups" eval="[(4,ref('group_converter_manager'))]"/>
  </record>
</odoo>
